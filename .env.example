# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_OPERATING_MODE=SIMULATED_DEMO
# Set a private random value here and use the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
PORT=3000

# Firebase Authentication and Firestore (server uses Cloud Run Application Default Credentials)
FIREBASE_PROJECT_ID=

# Gemini runs server-side via Vertex AI and the Cloud Run runtime identity.
# Enable aiplatform.googleapis.com and grant the runtime roles/aiplatform.user.
# Local calls need Application Default Credentials; no VITE_ Gemini key is used.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global
# Comma-separated allowlist of addresses that become BUSINESS_OWNER on first
# sign-in. Everything else self-signs-up as CUSTOMER. Keep this empty in the
# repository: an owner address in source is an open door.
OWNER_EMAILS=
OWNER_EMAIL=
DEFAULT_TENANT_ID=tenant-nordic
CORS_ALLOWED_ORIGINS=https://sokoflow.ai.studio

# Stock/order source of truth. "firestore" is the only safe value outside local dev.
# "memory" keeps stock in this process only and is lost on restart; checkout will
# oversell across instances, so it is an explicit opt-in for local development.
COMMERCE_STATE_BACKEND=firestore

# Seed the demo reference catalogue into empty workspaces. Defaults to on so local
# development has products to sell; production sets it to false.
SEED_REFERENCE_CATALOGUE=true

# Safaricom Daraja (M-Pesa). Leave blank to disable mobile-money checkout: the
# STK push route then answers 503 rather than inventing a receipt. There is no
# simulated fallback outside local development.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be publicly reachable and end in /api/payments/mpesa/callback
MPESA_CALLBACK_URL=https://your-cloud-run-service.run.app/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Local development only: allows POST /api/payments/mpesa/simulate, which settles
# an order with a receipt prefixed SIMULATED-. Ignored when NODE_ENV=production.
MPESA_ALLOW_SIMULATED=false

# Frontend build-time settings. Firebase web API keys are public identifiers, not server secrets.
VITE_API_BASE_URL=https://your-cloud-run-service.run.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Per-address request throttle, applied before token verification so an
# unauthenticated flood cannot make the service verify tokens in a loop.
# Defaults: 600 requests per 60s. The M-Pesa callback is exempt so Daraja retries
# are never delayed. Each instance counts separately; this bounds one client's
# burst, it is not a global rate limit.
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_WINDOW_MS=60000
