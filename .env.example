# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_OPERATING_MODE=SIMULATED_DEMO
# Set a private random value here and use the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
PORT=3000

# Firebase Authentication and Firestore (server uses Cloud Run Application Default Credentials)
FIREBASE_PROJECT_ID=
OWNER_EMAIL=
DEFAULT_TENANT_ID=tenant-nordic
CORS_ALLOWED_ORIGINS=https://sokoflow.ai.studio

# Frontend build-time settings. Firebase web API keys are public identifiers, not server secrets.
VITE_API_BASE_URL=https://your-cloud-run-service.run.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
